# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# AI Provider: "groq", "openai", or "gemini"
AI_PROVIDER=groq

# Groq Settings (if AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Settings (if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# System instruction for AI assistant
SYSTEM_PROMPT="Ты — вежливый, умный и полезный ассистент в Telegram. Ты отвечаешь четко, понятно и доброжелательно на любые вопросы."

# Maximum number of history messages remembered per user
MAX_HISTORY_MESSAGES=10
